# ═══════════════════════════════════════════════════════════════════════════
#  Shawarar Lafiya AI — Environment Configuration Template
#  Copy this file to `.env` and fill in your values.
#  NEVER commit `.env` to version control.
# ═══════════════════════════════════════════════════════════════════════════

# ── Application ──────────────────────────────────────────────────────────────
# Set APP_ENV to "production" in deployed environments
APP_ENV=development

# Set DEBUG=false in production to suppress stack traces in 500 responses
DEBUG=false

# Comma-separated list of allowed CORS origins. Use "*" in development only.
# In production, set to your frontend domain(s): https://yourapp.com,https://app2.com
CORS_ORIGINS=*

# ── Gemini LLM ───────────────────────────────────────────────────────────────
# Required for AI-powered clinical triage. Leave blank to use deterministic
# WHO IMCI offline rule engine (safe, no external calls).
GEMINI_API_KEY=

# Optional: override the default Gemini model variant
DEFAULT_LLM_MODEL=gemini-2.5-flash

# ── Twilio (WhatsApp + IVR) ───────────────────────────────────────────────────
# Required only for WhatsApp Business and IVR voice channel support.
# Leave blank to disable webhooks (web UI continues working).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886
TWILIO_VOICE_NUMBER=+1234567890

# ── Audio Upload ──────────────────────────────────────────────────────────────
# Directory where audio files from /triage/audio are temporarily stored
AUDIO_UPLOAD_DIR=uploads

# ── DHIS2 Referral Integration ────────────────────────────────────────────────
# Optional: Connect to a DHIS2 instance for real-time PHC referral data.
# Leave blank to use built-in offline PHC dataset (23 facilities, North Nigeria).
DHIS2_BASE_URL=https://dhis2.nigeria.gov.ng/api
DHIS2_USERNAME=
DHIS2_PASSWORD=
DHIS2_TIMEOUT_SECONDS=6.0
